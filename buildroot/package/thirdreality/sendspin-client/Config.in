config BR2_PACKAGE_SENDSPIN_CLIENT
	bool "sendspin-client"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_PULSEAUDIO
	select BR2_PACKAGE_TR_VOLUME
	select BR2_PACKAGE_AVAHI
	select BR2_PACKAGE_AVAHI_DAEMON
	select BR2_PACKAGE_AVAHI_LIBDNSSD_COMPATIBILITY
	help
	  Sendspin synchronized audio streaming client for ThirdReality speaker.
	  Uses PulseAudio for audio output and Avahi for mDNS discovery.

	  https://github.com/Sendspin/sendspin-cpp
